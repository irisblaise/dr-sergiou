# Sanity — copy to .env.local and fill in. Only the NEXT_PUBLIC_* vars reach the
# browser. Tokens are server-only and must NEVER be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-side read token used by the app to query content (the project does not
# allow anonymous API reads). Create a Viewer-scoped token at
# sanity.io/manage -> API -> Tokens. Add the same var in Vercel's env settings.
SANITY_API_READ_TOKEN=

# Only needed to run the one-off content seed script (npm run seed).
# Create an Editor/Write-scoped token. Keep secret.
SANITY_API_WRITE_TOKEN=
